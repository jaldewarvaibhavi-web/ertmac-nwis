# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: model used for explanations (default claude-sonnet-5)
NWIS_CLAUDE_MODEL=claude-sonnet-5
# Optional: tfidf (default, offline) or chroma (needs `pip install chromadb`, downloads an embedding model)
NWIS_VECTOR_BACKEND=tfidf
